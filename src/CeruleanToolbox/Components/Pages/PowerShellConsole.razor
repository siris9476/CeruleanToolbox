@page "/console"
@using CeruleanToolbox.Services
@using Microsoft.Extensions.Logging
@inject TerminalSessionService Shell
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ResourceInventoryService Inventory
@inject AksClusterService AksOps
@inject VmOperationsService VmOps
@inject ClusterReachabilityService Reachability
@inject ResourceGraphClient Graph
@inject ILogger<PowerShellConsole> Logger
@implements IAsyncDisposable

<PageTitle>@T("PowerShell console")</PageTitle>

<h1>@T("PowerShell console")</h1>

@if (!IsLocal)
{
    <div class="alert alert-warning">
        @T("The console is only available locally (desktop app or web app opened from") <code>localhost</code>): @T("it runs commands with the permissions of the service principal and must not be exposed on the network.")
    </div>
    return;
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<p class="text-muted small mb-2">
    @T("Real PowerShell terminal (Tab key, history with the arrow keys, colors, interactive programs).") <code>az</code> @T("logs in with the service principal of the active connection on the first call, in a private folder of this session;")
    <code>Invoke-Arm</code> @T("calls Azure Resource Manager with the same identity. Changing the active connection restarts the session.")
</p>
<p class="text-muted small mb-2">
    <strong>@T("kubectl and helm on AKS.")</strong> @T("Choose the cluster from the first menu (the page writes") <code>Use-Aks</code> @T("in the terminal for you).")
    @T("Then you have two options:")
    <strong>@T("with an agent VM")</strong> @T("in the cluster's network (second menu): commands run there with the admin credentials, like the pipeline with")
    <code>useClusterAdmin</code>, @T("and they also work on private clusters, but each command takes 1-3 minutes;")
    @T("or") <strong>@T("without a VM")</strong>: @T("commands go through Azure with the connection's Entra identity")
    (<code>az aks command invoke</code>) @T("and that identity needs an AKS RBAC role on the cluster.")
    "@T("Verify connection")" @T("really tests, from the chosen VM, whether the cluster is reachable.")
</p>

<div class="row g-2 align-items-start mb-2">
    <div class="col-md-3">
        <label class="form-label mb-0 small">Subscription</label>
        <SearchableSelect TItem="SubscriptionInfo" Items="ClusterSubscriptions"
                           GetLabel="@(s => s.DisplayName)" GetValue="@(s => s.SubscriptionId)"
                           SelectedValue="SelectedSubscriptionId" SelectedValueChanged="OnSubscriptionSelected"
                           Placeholder="@(IsLoadingClusters ? T("loading subscriptions...") : T("-- all --"))"
                           Disabled="@(IsLoadingClusters || ClusterSubscriptions.Count == 0)" />
    </div>
    <div class="col-md-4">
        <label class="form-label mb-0 small">@T("AKS cluster for kubectl and helm")</label>
        <SearchableSelect TItem="AksClusterInfo" Items="VisibleClusters"
                           GetLabel="@(c => $"{c.Name} · {c.ResourceGroup} · {SubscriptionNameOf(c.Id)}")" GetValue="@(c => c.Id)"
                           SelectedValue="SelectedClusterId" SelectedValueChanged="OnClusterSelectedAsync"
                           Placeholder="@(IsLoadingClusters ? T("loading clusters...") : T("-- choose a cluster --"))"
                           Disabled="@IsLoadingClusters" />
    </div>
    <div class="col-md-3">
        <label class="form-label mb-0 small text-nowrap" title='@T("The VM that runs kubectl and helm in the cluster network, with the admin credentials (like the pipeline)")'>@T("Agent VM (optional)")</label>
        <SearchableSelect TItem="VmInfo" Items="VmOptions"
                           GetLabel="@(v => $"{v.Name} · {v.ResourceGroup} · {v.PowerState}")" GetValue="@(v => v.Id)"
                           SelectedValue="SelectedAgentId" SelectedValueChanged="OnAgentSelectedAsync"
                           Placeholder="@(IsLoadingClusters ? T("loading VMs...") : IsCheckingNetwork ? T("checking network...") : T("-- none: through Azure, Entra identity --"))"
                           Disabled="@(IsLoadingClusters || IsCheckingNetwork)" />
        @if (!string.IsNullOrEmpty(NetworkNote))
        {
            <div class="form-text">@NetworkNote</div>
        }
    </div>
    <div class="col-auto">
        @* The empty label keeps the button on the same line as the menus (their labels take one line above them). *@
        <label class="form-label mb-0 small d-block">&nbsp;</label>
        <button class="btn btn-sm btn-outline-primary" disabled="@(!CanVerifyConnection)" @onclick="VerifyConnectionAsync"
                title='@T("Runs a read-only script on the (running) VM: resolves the cluster name and tests port 443")'>
            @T("Verify connection")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(LoadNote))
{
    <div class="form-text mb-2">@LoadNote</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <button class="btn btn-sm btn-outline-secondary" @onclick="RestartAsync">@T("New session")</button>
    <button class="btn btn-sm btn-outline-danger" @onclick="StopAsync">@T("Close session")</button>
    <div class="form-check mb-0 ms-3">
        <input class="form-check-input" type="checkbox" id="aks-direct" @bind="UseDirectAccess" />
        <label class="form-check-label small" for="aks-direct">@T("Direct access (needs network access to the cluster)")</label>
    </div>
</div>

<div @ref="_host" style="height: 65vh; background: #012456; padding: 6px; border-radius: 4px;"></div>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PowerShellConsole>? _self;
    private string ErrorMessage { get; set; } = "";
    private bool _disposed;

    private List<AksClusterInfo> Clusters { get; set; } = new();
    private List<SubscriptionInfo> Subscriptions { get; set; } = new();
    private List<VmInfo> Vms { get; set; } = new();
    private List<VmInfo> VisibleVms { get; set; } = new();
    private readonly Dictionary<string, HashSet<string>?> _reachCache = new();
    private bool IsCheckingNetwork { get; set; }
    private string NetworkNote { get; set; } = "";
    private string SelectedAgentId { get; set; } = "";
    private string SelectedClusterId { get; set; } = "";
    private bool IsLoadingClusters { get; set; } = true;
    private bool UseDirectAccess { get; set; }

    private string SubscriptionNameOf(string resourceId)
    {
        var id = SubscriptionIdOf(resourceId);
        return Subscriptions.FirstOrDefault(s => string.Equals(s.SubscriptionId, id, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? id;
    }

    private static string SubscriptionIdOf(string resourceId) =>
        resourceId.Split('/', StringSplitOptions.RemoveEmptyEntries).ElementAtOrDefault(1) ?? "";

    private static string PsQuote(string value) => "'" + value.Replace("'", "''") + "'";

    private string LoadNote { get; set; } = "";

    // Subscription filter for the cluster and VM menus ("-- all --" = no filter). Only subscriptions that contain a cluster are
    // offered. Pick "all" to choose an agent VM that lives in another subscription (e.g. a hub network).
    private string SelectedSubscriptionId { get; set; } = "";

    private bool InSelectedSubscription(string resourceId) =>
        string.IsNullOrEmpty(SelectedSubscriptionId) ||
        string.Equals(SubscriptionIdOf(resourceId), SelectedSubscriptionId, StringComparison.OrdinalIgnoreCase);

    private List<SubscriptionInfo> ClusterSubscriptions => Subscriptions
        .Where(s => Clusters.Any(c => string.Equals(SubscriptionIdOf(c.Id), s.SubscriptionId, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<AksClusterInfo> VisibleClusters => Clusters.Where(c => InSelectedSubscription(c.Id)).ToList();

    // VisibleVms is what the reachability estimate leaves for the chosen cluster; the subscription filter narrows it further.
    private List<VmInfo> VmOptions => VisibleVms.Where(v => InSelectedSubscription(v.Id)).ToList();

    private void OnSubscriptionSelected(string subscriptionId)
    {
        SelectedSubscriptionId = subscriptionId;

        // A cluster or VM chosen before and now outside the subscription is dropped, so the menus never show something the filter hides.
        if (SelectedCluster is { } cluster && !InSelectedSubscription(cluster.Id)) SelectedClusterId = "";
        if (SelectedAgent is { } agent && !InSelectedSubscription(agent.Id)) SelectedAgentId = "";
    }

    // Clusters and VMs of every subscription the connection can read come from Azure Resource Graph: a couple of calls in all, instead
    // of one listing per subscription (and one more per VM for its power state), which never finished on connections that see
    // 100+ subscriptions. Loaded after the terminal is up, so it never delays the shell.
    private async Task LoadClustersAsync()
    {
        try
        {
            var subscriptions = Inventory.ListSubscriptionsAsync();
            var clusters = Graph.QueryRowsAsync(
                "resources | where type =~ 'microsoft.containerservice/managedclusters' " +
                "| project name, location, resourceGroup, id, power = tostring(properties.powerState.code)");
            var vms = Graph.QueryRowsAsync(
                "resources | where type =~ 'microsoft.compute/virtualmachines' " +
                "| project name, location, resourceGroup, id, power = tostring(properties.extended.instanceView.powerState.displayStatus)");
            await Task.WhenAll(subscriptions, clusters, vms);

            Subscriptions = subscriptions.Result;
            Clusters = clusters.Result
                .Select(r => new AksClusterInfo(r["name"], r.GetValueOrDefault("location", "-"), r.GetValueOrDefault("power", "") is { Length: > 0 } p ? p : "Unknown",
                                                r.GetValueOrDefault("resourceGroup", "-"), r["id"]))
                .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            Vms = vms.Result
                .Select(r => new VmInfo(r["name"], r.GetValueOrDefault("location", "-"), r.GetValueOrDefault("power", "") is { Length: > 0 } p ? p : "Unknown",
                                        r.GetValueOrDefault("resourceGroup", "-"), r["id"]))
                .OrderBy(v => v.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            VisibleVms = Vms;
            LoadNote = Clusters.Count == 0 ? T("No AKS cluster visible with this connection.") : "";
        }
        catch (Exception ex)
        {
            ErrorMessage = T("Cluster list not available: {0}", ex.Message);
        }
        finally
        {
            IsLoadingClusters = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private AksClusterInfo? SelectedCluster => Clusters.FirstOrDefault(c => c.Id == SelectedClusterId);
    private VmInfo? SelectedAgent => Vms.FirstOrDefault(v => v.Id == SelectedAgentId);
    // run-command needs a running VM: a deallocated one (e.g. a dev VM shut down by its schedule) would only fail.
    private bool CanVerifyConnection => SelectedCluster is not null && SelectedAgent is not null && Shell.IsRunning &&
                                        SelectedAgent.PowerState.Contains("running", StringComparison.OrdinalIgnoreCase);

    // Types Test-AksAgent into the terminal: it runs a read-only probe script on the VM and prints the verdict there.
    private async Task VerifyConnectionAsync()
    {
        try
        {
            var cluster = SelectedCluster;
            var agent = SelectedAgent;
            if (cluster is null || agent is null || !Shell.IsRunning) return;

            Shell.Write($"Test-AksAgent -Name {PsQuote(cluster.Name)} -ResourceGroup {PsQuote(cluster.ResourceGroup)} " +
                        $"-SubscriptionId {PsQuote(SubscriptionIdOf(cluster.Id))} " +
                        $"-Agent {PsQuote(agent.Name)} -AgentResourceGroup {PsQuote(agent.ResourceGroup)}\r");
            if (_module is not null) await _module.InvokeVoidAsync("focus");
        }
        catch (Exception ex)
        {
            Report(T("Connection check"), ex);
        }
    }

    // Narrows the VM menu to the Linux VMs that can reach the chosen cluster (estimated from network metadata).
    private async Task ApplyReachabilityAsync(AksClusterInfo cluster)
    {
        if (!_reachCache.TryGetValue(cluster.Id, out var reachable))
        {
            IsCheckingNetwork = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                reachable = await Reachability.GetLinuxVmIdsReachingClusterAsync(cluster.Id);
                _reachCache[cluster.Id] = reachable;
            }
            catch (Exception ex)
            {
                reachable = null;
                NetworkNote = T("Network check failed ({0}): showing all VMs.", ex.Message);
            }
            finally
            {
                IsCheckingNetwork = false;
            }
        }

        if (reachable is null)
        {
            VisibleVms = Vms;
            if (string.IsNullOrEmpty(NetworkNote) || !NetworkNote.StartsWith(T("Network check failed")))
            {
                NetworkNote = T("Cluster is not private or uses an Azure-managed DNS zone: cannot estimate, showing all VMs.");
            }
        }
        else
        {
            VisibleVms = Vms.Where(v => reachable.Contains(v.Id.ToLowerInvariant())).ToList();
            NetworkNote = T("Linux VMs that reach the cluster: {0} (estimated from network and private DNS; NSGs and firewalls not evaluated).", VisibleVms.Count);
        }

        if (!VisibleVms.Any(v => v.Id == SelectedAgentId)) SelectedAgentId = "";
        await InvokeAsync(StateHasChanged);
    }

    // Changing the agent VM re-applies the cluster that is already selected.
    private async Task OnAgentSelectedAsync(string vmId)
    {
        SelectedAgentId = vmId;
        if (!string.IsNullOrEmpty(SelectedClusterId)) await OnClusterSelectedAsync(SelectedClusterId);
    }

    // Types the Use-Aks command into the terminal, so what happens stays visible and can be repeated by hand.
    private async Task OnClusterSelectedAsync(string clusterId)
    {
        try
        {
            SelectedClusterId = clusterId;
            var cluster = Clusters.FirstOrDefault(c => c.Id == clusterId);
            if (cluster is null) return;

            await ApplyReachabilityAsync(cluster);

            if (!Shell.IsRunning)
            {
                await RestartAsync();
            }

            var command = $"Use-Aks {PsQuote(cluster.Name)} -ResourceGroup {PsQuote(cluster.ResourceGroup)} " +
                          $"-SubscriptionId {PsQuote(SubscriptionIdOf(cluster.Id))}" + (UseDirectAccess ? " -Direct" : "");

            var agent = Vms.FirstOrDefault(v => v.Id == SelectedAgentId);
            if (agent is not null)
            {
                command += $" -Agent {PsQuote(agent.Name)} -AgentResourceGroup {PsQuote(agent.ResourceGroup)}";
            }

            Shell.Write(command + "\r");

            if (_module is not null) await _module.InvokeVoidAsync("focus");
        }
        catch (Exception ex)
        {
            Report(T("Cluster selection"), ex);
        }
    }

    // Batches output so a flood of lines becomes a few JS calls instead of one per chunk.
    private readonly System.Text.StringBuilder _pending = new();
    private readonly object _pendingLock = new();
    private bool _flushScheduled;

    // The server only listens on loopback in this setup; the desktop shell's virtual host is 0.0.0.0.
    private bool IsLocal
    {
        get
        {
            var host = new Uri(Navigation.BaseUri).Host;
            return host is "localhost" or "127.0.0.1" or "[::1]" or "::1" or "0.0.0.0";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !IsLocal) return;

        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/terminal.js");
            var size = await _module.InvokeAsync<int[]>("init", _host, _self);

            // Replay what the shell printed while this page was away, then attach live output.
            var backlog = Shell.Backlog;
            if (backlog.Length > 0) await _module.InvokeVoidAsync("write", backlog);

            Shell.Output += OnShellOutput;
            Shell.Exited += OnShellExited;
            Shell.StartOrResize((short)size[0], (short)size[1]);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            StateHasChanged();
        }

        await LoadClustersAsync();
    }

    // Everything the user can trigger below is guarded: an exception that escapes an event handler takes the whole
    // Blazor circuit down and leaves the unhandled-error bar, so it is reported on the page and
    // in the logs instead (Report).
    private void Report(string what, Exception ex)
    {
        Logger.LogWarning(ex, "Console PowerShell: {What}", what);
        ErrorMessage = $"{what}: {ex.Message}";
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnInput(string data)
    {
        try
        {
            if (!Shell.IsRunning)
            {
                // After `exit`, any key starts a fresh session.
                _ = RestartAsync();
                return;
            }

            Shell.Write(data);
        }
        catch (Exception ex)
        {
            Report(T("Terminal input"), ex);
        }
    }

    [JSInvokable]
    public void OnResize(int columns, int rows)
    {
        try
        {
            if (columns > 0 && rows > 0) Shell.Resize((short)columns, (short)rows);
        }
        catch (Exception ex)
        {
            Report(T("Terminal resize"), ex);
        }
    }

    private void OnShellOutput(string text)
    {
        lock (_pendingLock)
        {
            _pending.Append(text);
            if (_flushScheduled) return;
            _flushScheduled = true;
        }

        _ = Task.Delay(15).ContinueWith(_ => InvokeAsync(FlushAsync));
    }

    private async Task FlushAsync()
    {
        string text;
        lock (_pendingLock)
        {
            text = _pending.ToString();
            _pending.Clear();
            _flushScheduled = false;
        }

        if (_module is null || _disposed || text.Length == 0) return;

        try
        {
            await _module.InvokeVoidAsync("write", text);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException)
        {
            // the page or the circuit is going away: the output has nowhere to be shown
        }
    }

    private void OnShellExited()
    {
        lock (_pendingLock) _pending.Append("\r\n\x1b[33m[" + T("session ended: press any key to restart") + "]\x1b[0m\r\n");
        _ = InvokeAsync(FlushAsync);
    }

    private async Task RestartAsync()
    {
        if (_module is null) return;

        try
        {
            Shell.Stop();
            await _module.InvokeVoidAsync("clear");
            var size = await _module.InvokeAsync<int[]>("init", _host, _self);
            Shell.StartOrResize((short)size[0], (short)size[1]);
            await _module.InvokeVoidAsync("focus");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        try
        {
            Shell.Stop();
            if (_module is not null) await _module.InvokeVoidAsync("write", "\r\n\x1b[33m[" + T("session closed") + "]\x1b[0m\r\n");
        }
        catch (Exception ex)
        {
            Report(T("Closing the session"), ex);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Shell.Output -= OnShellOutput;
        Shell.Exited -= OnShellExited;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException or InvalidOperationException)
            {
                // leaving while the circuit or the WebView is already closing: nothing left to clean up on the JS side
            }
        }

        _self?.Dispose();
    }
}
