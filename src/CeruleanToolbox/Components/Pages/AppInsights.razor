@page "/appinsights"
@using CeruleanToolbox.Services
@inject ResourceInventoryService Inventory
@inject AppInsightsService AppInsightsOps
@inherits CeruleanToolboxPageBase

<PageTitle>Application Insights</PageTitle>

<h1>Application Insights</h1>

@if (SelectedComponent is null)
{
    <p>
        @T("Lists the Application Insights components. Click a component name, or double-click its row, to open its overview and query it with KQL.")
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">@T("Subscription (optional)")</label>
            <SearchableSelect TItem="SubscriptionInfo" Items="Subscriptions"
                               GetLabel="@(s => $"{s.DisplayName} ({s.SubscriptionId})")" GetValue="@(s => s.SubscriptionId)"
                               SelectedValue="SelectedSubscriptionId" SelectedValueChanged="OnSubscriptionChangedAsync"
                               Placeholder='@T("-- all --")' Disabled="@(IsLoading || IsBusy)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@T("Filter by name")</label>
            <input class="form-control" placeholder='@T("filter...")' @bind="NameFilter" @bind:event="oninput" />
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-info")">@StatusMessage</div>
}

@if (SelectedComponent is null)
{
    @if (string.IsNullOrEmpty(SelectedSubscriptionId) && !HasLoadedAllSubscriptions && !IsLoading)
    {
        <div class="alert alert-secondary">
            @T("No subscription selected: choose one for a quick view, or")
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadAllSubscriptionsAsync">@T("Load all subscriptions")</button>
            @T("— it may take a while if you have many.")
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
            <span>@T("Loading components...")</span>
        </div>
    }

    @if (!IsLoading && (!string.IsNullOrEmpty(SelectedSubscriptionId) || HasLoadedAllSubscriptions))
    {
        @if (!FilteredComponents.Any())
        {
            <p><em>@T("No Application Insights components found.")</em></p>
        }
        else
        {
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr><th>@T("Name")</th><th>Subscription</th><th>Resource Group</th><th>Location</th><th>@T("Retention (days)")</th></tr>
                </thead>
                <tbody>
                    @foreach (var component in FilteredComponents)
                    {
                        <tr style="cursor: pointer;" title='@T("Double-click to open the component")' @ondblclick="() => OpenComponentAsync(component)">
                            <td>
                                <button class="btn btn-link p-0 fw-semibold text-decoration-none" disabled="@IsBusy" @onclick="() => OpenComponentAsync(component)">
                                    @component.Name <span aria-hidden="true">&rsaquo;</span>
                                </button>
                            </td>
                            <td>@GetSubscriptionName(component.Id)</td>
                            <td>@component.ResourceGroup</td>
                            <td>@component.Location</td>
                            <td>@(component.RetentionInDays?.ToString() ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="CloseComponent">&larr; Application Insights</button>
        <h4 class="mb-0">@SelectedComponent.Name</h4>
        @if (Overview is not null)
        {
            <span class="badge bg-secondary">@Overview.Status</span>
        }
        <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@IsBusy" @onclick="RefreshComponentAsync">@T("Refresh")</button>
    </div>
    <p class="text-muted small">
        @GetSubscriptionName(SelectedComponent.Id) · Resource group @SelectedComponent.ResourceGroup · @SelectedComponent.Location
    </p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(ActiveTab == "overview" ? "active" : "")" @onclick='() => ActiveTab = "overview"'>@T("Overview")</button></li>
        <li class="nav-item"><button class="nav-link @(ActiveTab == "query" ? "active" : "")" @onclick='() => ActiveTab = "query"'>Query KQL</button></li>
    </ul>

    @if (ActiveTab == "overview" && Overview is not null)
    {
        <ResourceOverviewView Overview="Overview" />

        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleConnectionInfo">
            @(ShowConnectionInfo ? T("Hide connection string") : T("Show connection string"))
        </button>
        @if (ShowConnectionInfo)
        {
            <p class="mt-2"><code>@SelectedComponent.ConnectionString</code></p>
        }
    }
    else if (ActiveTab == "query")
    {
    <div class="mb-3">
        <label class="form-label">Query KQL</label>
        <textarea class="form-control" rows="6" @bind="QueryText"></textarea>
        <div class="form-text">
            @T("Examples:") <code>requests | order by timestamp desc | take 50</code> ·
            <code>exceptions | summarize count() by type | order by count_ desc</code> ·
            <code>traces | where severityLevel >= 2 | order by timestamp desc | take 50</code>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label class="form-label">@T("Time range")</label>
            <select class="form-select" @bind="LookbackHours">
                <option value="1">@T("Last hour")</option>
                <option value="24">@T("Last 24 hours")</option>
                <option value="168">@T("Last 7 days")</option>
                <option value="720">@T("Last 30 days")</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(QueryText) || IsBusy)" @onclick="RunQueryAsync">
                @(IsBusy ? T("Running...") : T("Run query"))
            </button>
        </div>
    </div>

    @if (QueryResult is not null)
    {
        <h3>@T("Results ({0} of {1} rows)", QueryResult.Rows.Count, QueryResult.TotalRowCount)</h3>
        @if (QueryResult.Truncated)
        {
            <div class="alert alert-warning">
                @T("Showing only the first {0} rows out of {1} — beyond this limit the browser freezes rendering the table. Narrow the query with", QueryResult.Rows.Count, QueryResult.TotalRowCount)
                <code>take</code>, <code>summarize</code> @T("or additional filters to see more targeted results.")
            </div>
        }
        <div style="overflow: auto; max-height: 500px;">
            <table class="table table-sm">
                <thead>
                    <tr>
                        @foreach (var column in QueryResult.Columns)
                        {
                            <th>@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in QueryResult.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    }
}

@code {
    private List<AppInsightsComponentInfo> Components { get; set; } = new();
    private AppInsightsQueryResult? QueryResult { get; set; }

    private string SelectedSubscriptionId { get; set; } = "";
    private string SelectedComponentId { get; set; } = "";
    private string NameFilter { get; set; } = "";
    private ResourceOverview? Overview { get; set; }
    private string ActiveTab { get; set; } = "overview";
    private string QueryText { get; set; } = "requests | order by timestamp desc | take 50";
    private int LookbackHours { get; set; } = 24;
    private bool ShowConnectionInfo { get; set; }

    private AppInsightsComponentInfo? SelectedComponent =>
        Components.FirstOrDefault(c => c.Id == SelectedComponentId);

    private IEnumerable<AppInsightsComponentInfo> FilteredComponents => Components.Where(c =>
        string.IsNullOrWhiteSpace(NameFilter) || c.Name.Contains(NameFilter, StringComparison.OrdinalIgnoreCase));


    protected override async Task OnInitializedAsync()
    {
        try
        {
            Subscriptions = await Inventory.ListSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }

        await AutoOpenAsync();
    }

    private async Task AutoOpenAsync()
    {
        var id = RequestedResourceId;
        if (id is null || Subscriptions.Count == 0) return;

        await OnSubscriptionChangedAsync(RequestedSubscriptionId ?? "");
        var item = Components.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
        if (item is not null)
        {
            await OpenComponentAsync(item);
        }
    }

    private async Task OnSubscriptionChangedAsync(string subscriptionId)
    {
        SelectedSubscriptionId = subscriptionId;
        Components.Clear();
        SelectedComponentId = "";
        QueryResult = null;
        ShowConnectionInfo = false;
        HasLoadedAllSubscriptions = false;

        // Clearing back to "all" doesn't auto-load: fetching every subscription is expensive,
        // so it waits for the explicit button below instead of firing on every selection change.
        if (string.IsNullOrEmpty(SelectedSubscriptionId)) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            Components = await AppInsightsOps.ListAllAsync(SelectedSubscriptionId);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadAllSubscriptionsAsync()
    {
        HasLoadedAllSubscriptions = true;
        IsLoading = true;
        StateHasChanged();

        try
        {
            var components = new List<AppInsightsComponentInfo>();
            foreach (var sub in Subscriptions)
            {
                components.AddRange(await AppInsightsOps.ListAllAsync(sub.SubscriptionId));
            }

            Components = components;
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenComponentAsync(AppInsightsComponentInfo component)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Opening {0}...", component.Name), error: false);
        StateHasChanged();

        try
        {
            Overview = await AppInsightsOps.GetOverviewAsync(component.Id);
            SelectedComponentId = component.Id;
            ActiveTab = "overview";
            QueryResult = null;
            ShowConnectionInfo = false;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void CloseComponent()
    {
        SelectedComponentId = "";
        Overview = null;
        QueryResult = null;
        ShowConnectionInfo = false;
        SetStatus("", error: false);
    }

    private async Task RefreshComponentAsync()
    {
        if (IsBusy || SelectedComponent is null) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            Overview = await AppInsightsOps.GetOverviewAsync(SelectedComponent.Id);
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ToggleConnectionInfo() => ShowConnectionInfo = !ShowConnectionInfo;

    private async Task RunQueryAsync()
    {
        IsBusy = true;
        SetStatus(T("Running query..."), error: false);
        QueryResult = null;
        StateHasChanged();

        try
        {
            QueryResult = await AppInsightsOps.RunQueryAsync(
                SelectedComponentId, QueryText, TimeSpan.FromHours(LookbackHours));
            SetStatus(T("Query completed: {0} rows.", QueryResult.TotalRowCount), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
