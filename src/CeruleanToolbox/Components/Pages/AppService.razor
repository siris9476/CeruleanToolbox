@page "/appservice"
@using CeruleanToolbox.Services
@inject ResourceInventoryService Inventory
@inject AppServiceOperationsService AppServiceOps
@inherits CeruleanToolboxPageBase

<PageTitle>App Service</PageTitle>

<h1>App Service</h1>

@if (SelectedApp is null)
{
    <p>
        @T("Lists the web apps (Function Apps have their own page). Click an app's name, or double-click its row, to open its overview.")
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">@T("Subscription (optional)")</label>
            <SearchableSelect TItem="SubscriptionInfo" Items="Subscriptions"
                               GetLabel="@(s => $"{s.DisplayName} ({s.SubscriptionId})")" GetValue="@(s => s.SubscriptionId)"
                               SelectedValue="SelectedSubscriptionId" SelectedValueChanged="OnSubscriptionChangedAsync"
                               Placeholder='@T("-- all --")' Disabled="@(IsLoading || IsBusy)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@T("Filter by name")</label>
            <input class="form-control" placeholder='@T("filter...")' @bind="NameFilter" @bind:event="oninput" />
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-info")">@StatusMessage</div>
}

@if (SelectedApp is null)
{
    @if (string.IsNullOrEmpty(SelectedSubscriptionId) && !HasLoadedAllSubscriptions && !IsLoading)
    {
        <div class="alert alert-secondary">
            @T("No subscription selected: pick one for a quick view, or")
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadAllSubscriptionsAsync">@T("Load all subscriptions")</button>
            @T("— it may take a while if you have many.")
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
            <span>@T("Loading...")</span>
        </div>
    }

    @if (!IsLoading && (!string.IsNullOrEmpty(SelectedSubscriptionId) || HasLoadedAllSubscriptions))
    {
        @if (!FilteredApps.Any())
        {
            <p><em>@T("No web apps found.")</em></p>
        }
        else
        {
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr><th>@T("Name")</th><th>Subscription</th><th>Resource Group</th><th>Location</th><th>@T("Status")</th><th>@T("Actions")</th></tr>
                </thead>
                <tbody>
                    @foreach (var app in FilteredApps)
                    {
                        <tr style="cursor: pointer;" title='@T("Double-click to open the app")' @ondblclick="() => OpenAppAsync(app)">
                            <td>
                                <button class="btn btn-link p-0 fw-semibold text-decoration-none" disabled="@IsBusy" @onclick="() => OpenAppAsync(app)">
                                    @app.Name <span aria-hidden="true">&rsaquo;</span>
                                </button>
                            </td>
                            <td>@GetSubscriptionName(app.Id)</td>
                            <td>@app.ResourceGroup</td>
                            <td>@app.Location</td>
                            <td>@app.State</td>
                            <td @ondblclick:stopPropagation="true">
                                <button class="btn btn-sm btn-success" disabled="@IsBusy" @onclick="() => StartAsync(app)">Start</button>
                                <button class="btn btn-sm btn-warning" disabled="@IsBusy" @onclick="() => StopAsync(app)">Stop</button>
                                <button class="btn btn-sm btn-secondary" disabled="@IsBusy" @onclick="() => RestartAsync(app)">Restart</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="CloseApp">&larr; App Service</button>
        <h4 class="mb-0">@SelectedApp.Name</h4>
        @if (Overview is not null)
        {
            <span class="badge bg-secondary">@Overview.Status</span>
        }
        <div class="ms-auto d-flex gap-1">
            <button class="btn btn-sm btn-success" disabled="@IsBusy" @onclick="() => StartAsync(SelectedApp)">Start</button>
            <button class="btn btn-sm btn-warning" disabled="@IsBusy" @onclick="() => StopAsync(SelectedApp)">Stop</button>
            <button class="btn btn-sm btn-secondary" disabled="@IsBusy" @onclick="() => RestartAsync(SelectedApp)">Restart</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="RefreshAppAsync">@T("Refresh")</button>
        </div>
    </div>
    <p class="text-muted small">
        @GetSubscriptionName(SelectedApp.Id) · Resource group @SelectedApp.ResourceGroup · @SelectedApp.Location
    </p>

    @if (Overview is not null)
    {
        <ResourceOverviewView Overview="Overview" />
    }
}

@code {
    private List<WebAppInfo> Apps { get; set; } = new();
    private string SelectedSubscriptionId { get; set; } = "";
    private string NameFilter { get; set; } = "";

    private WebAppInfo? SelectedApp { get; set; }
    private ResourceOverview? Overview { get; set; }

    private IEnumerable<WebAppInfo> FilteredApps => Apps.Where(a =>
        string.IsNullOrWhiteSpace(NameFilter) || a.Name.Contains(NameFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Subscriptions = await Inventory.ListSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }

        await AutoOpenAsync();
    }

    private async Task AutoOpenAsync()
    {
        var id = RequestedResourceId;
        if (id is null || Subscriptions.Count == 0) return;

        await OnSubscriptionChangedAsync(RequestedSubscriptionId ?? "");
        var item = Apps.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
        if (item is not null)
        {
            await OpenAppAsync(item);
        }
        else
        {
            // A site that is not a web app is a function app: continue on its own page.
            Navigation.NavigateTo($"/functions?open={Uri.EscapeDataString(RequestedResourceId)}");
        }
    }

    private async Task OnSubscriptionChangedAsync(string subscriptionId)
    {
        SelectedSubscriptionId = subscriptionId;
        Apps = new();
        HasLoadedAllSubscriptions = false;

        // Clearing back to "all" doesn't auto-load: fetching every subscription is expensive,
        // so it waits for the explicit button instead of firing on every selection change.
        if (string.IsNullOrEmpty(SelectedSubscriptionId)) return;

        await LoadAsync(new[] { SelectedSubscriptionId });
    }

    private async Task LoadAllSubscriptionsAsync()
    {
        HasLoadedAllSubscriptions = true;
        await LoadAsync(Subscriptions.Select(s => s.SubscriptionId).ToList());
    }

    private async Task LoadAsync(IEnumerable<string> subscriptionIds)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var apps = new List<WebAppInfo>();
            foreach (var id in subscriptionIds)
            {
                apps.AddRange(await AppServiceOps.ListAllWebAppsAsync(id));
            }

            Apps = apps;
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenAppAsync(WebAppInfo app)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Opening {0}...", app.Name), error: false);
        StateHasChanged();

        try
        {
            Overview = await AppServiceOps.GetOverviewAsync(app.Id);
            SelectedApp = app;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void CloseApp()
    {
        SelectedApp = null;
        Overview = null;
        SetStatus("", error: false);
    }

    private async Task RefreshAppAsync()
    {
        if (IsBusy || SelectedApp is null) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            Overview = await AppServiceOps.GetOverviewAsync(SelectedApp.Id);
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task StartAsync(WebAppInfo app) => RunActionAsync(app, AppServiceOps.StartAsync, "Starting {0}...");
    private Task StopAsync(WebAppInfo app) => RunActionAsync(app, AppServiceOps.StopAsync, "Stopping {0}...");
    private Task RestartAsync(WebAppInfo app) => RunActionAsync(app, AppServiceOps.RestartAsync, "Restarting {0}...");

    // statusFormat is the English text of the progress message; it is translated here.
    private async Task RunActionAsync(WebAppInfo app, Func<string, CancellationToken, Task> action, string statusFormat)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T(statusFormat, app.Name), error: false);
        StateHasChanged();

        try
        {
            await action(app.Id, CancellationToken.None);

            if (SelectedApp is not null)
            {
                Overview = await AppServiceOps.GetOverviewAsync(SelectedApp.Id);
            }
            else
            {
                await LoadAsync(string.IsNullOrEmpty(SelectedSubscriptionId)
                    ? Subscriptions.Select(s => s.SubscriptionId).ToList()
                    : new[] { SelectedSubscriptionId });
            }

            SetStatus(T("Operation completed."), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
