@page "/appgateway"
@using CeruleanToolbox.Services
@inject ResourceInventoryService Inventory
@inject ApplicationGatewayService GatewayOps
@inherits CeruleanToolboxPageBase

<PageTitle>Application Gateway</PageTitle>

<h1>Application Gateway</h1>

@if (SelectedGateway is null)
{
    <p>
        @T("Lists the Application Gateways. Click a gateway name, or double-click its row, to open its overview with listeners, routing rules, backend pools and probes.")
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">@T("Subscription (optional)")</label>
            <SearchableSelect TItem="SubscriptionInfo" Items="Subscriptions"
                               GetLabel="@(s => $"{s.DisplayName} ({s.SubscriptionId})")" GetValue="@(s => s.SubscriptionId)"
                               SelectedValue="SelectedSubscriptionId" SelectedValueChanged="OnSubscriptionChangedAsync"
                               Placeholder="@T("-- all --")" Disabled="@(IsLoading || IsBusy)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@T("Filter by name")</label>
            <input class="form-control" placeholder="@T("filter...")" @bind="NameFilter" @bind:event="oninput" />
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-info")">@StatusMessage</div>
}

@if (SelectedGateway is null)
{
    @if (string.IsNullOrEmpty(SelectedSubscriptionId) && !HasLoadedAllSubscriptions && !IsLoading)
    {
        <div class="alert alert-secondary">
            @T("No subscription selected: pick one for a quick view, or")
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadAllSubscriptionsAsync">@T("Load all subscriptions")</button>
            @T("— it can take a while if you have many.")
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
            <span>@T("Loading...")</span>
        </div>
    }

    @if (!IsLoading && (!string.IsNullOrEmpty(SelectedSubscriptionId) || HasLoadedAllSubscriptions))
    {
        @if (!FilteredGateways.Any())
        {
            <p><em>@T("No Application Gateways found.")</em></p>
        }
        else
        {
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr><th>@T("Name")</th><th>Subscription</th><th>Resource Group</th><th>Location</th><th>@T("Status")</th><th>@T("Actions")</th></tr>
                </thead>
                <tbody>
                    @foreach (var gw in FilteredGateways)
                    {
                        <tr style="cursor: pointer;" title="@T("Double-click to open the gateway")" @ondblclick="() => OpenGatewayAsync(gw)">
                            <td>
                                <button class="btn btn-link p-0 fw-semibold text-decoration-none" disabled="@IsBusy" @onclick="() => OpenGatewayAsync(gw)">
                                    @gw.Name <span aria-hidden="true">&rsaquo;</span>
                                </button>
                            </td>
                            <td>@GetSubscriptionName(gw.Id)</td>
                            <td>@gw.ResourceGroup</td>
                            <td>@gw.Location</td>
                            <td>@gw.OperationalState</td>
                            <td @ondblclick:stopPropagation="true">
                                <button class="btn btn-sm btn-success" disabled="@IsBusy" @onclick="() => StartAsync(gw)">Start</button>
                                <button class="btn btn-sm btn-warning" disabled="@IsBusy" @onclick="() => StopAsync(gw)">Stop</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="CloseGateway">&larr; Application Gateway</button>
        <h4 class="mb-0">@SelectedGateway.Name</h4>
        @if (Overview is not null)
        {
            <span class="badge bg-secondary">@Overview.Status</span>
        }
        <div class="ms-auto d-flex gap-1">
            <button class="btn btn-sm btn-success" disabled="@IsBusy" @onclick="() => StartAsync(SelectedGateway)">Start</button>
            <button class="btn btn-sm btn-warning" disabled="@IsBusy" @onclick="() => StopAsync(SelectedGateway)">Stop</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="RefreshGatewayAsync">@T("Refresh")</button>
        </div>
    </div>
    <p class="text-muted small">
        @GetSubscriptionName(SelectedGateway.Id) · @T("Resource group {0}", SelectedGateway.ResourceGroup) ·@SelectedGateway.Location
    </p>

    @if (Overview is not null)
    {
        <ResourceOverviewView Overview="Overview" />
    }
}

@code {
    private List<ApplicationGatewayInfo> Gateways { get; set; } = new();
    private string SelectedSubscriptionId { get; set; } = "";
    private string NameFilter { get; set; } = "";

    private ApplicationGatewayInfo? SelectedGateway { get; set; }
    private ResourceOverview? Overview { get; set; }

    private IEnumerable<ApplicationGatewayInfo> FilteredGateways => Gateways.Where(g =>
        string.IsNullOrWhiteSpace(NameFilter) || g.Name.Contains(NameFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Subscriptions = await Inventory.ListSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }

        await AutoOpenAsync();
    }

    private async Task AutoOpenAsync()
    {
        var id = RequestedResourceId;
        if (id is null || Subscriptions.Count == 0) return;

        await OnSubscriptionChangedAsync(RequestedSubscriptionId ?? "");
        var item = Gateways.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
        if (item is not null)
        {
            await OpenGatewayAsync(item);
        }
    }

    private async Task OnSubscriptionChangedAsync(string subscriptionId)
    {
        SelectedSubscriptionId = subscriptionId;
        Gateways = new();
        HasLoadedAllSubscriptions = false;

        // Clearing back to "all" doesn't auto-load: fetching every subscription is expensive,
        // so it waits for the explicit button instead of firing on every selection change.
        if (string.IsNullOrEmpty(SelectedSubscriptionId)) return;

        await LoadAsync(new[] { SelectedSubscriptionId });
    }

    private async Task LoadAllSubscriptionsAsync()
    {
        HasLoadedAllSubscriptions = true;
        await LoadAsync(Subscriptions.Select(s => s.SubscriptionId).ToList());
    }

    private async Task LoadAsync(IEnumerable<string> subscriptionIds)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var gateways = new List<ApplicationGatewayInfo>();
            foreach (var id in subscriptionIds)
            {
                gateways.AddRange(await GatewayOps.ListAllAsync(id));
            }

            Gateways = gateways;
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenGatewayAsync(ApplicationGatewayInfo gateway)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Opening {0}...", gateway.Name), error: false);
        StateHasChanged();

        try
        {
            Overview = await GatewayOps.GetOverviewAsync(gateway.Id);
            SelectedGateway = gateway;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void CloseGateway()
    {
        SelectedGateway = null;
        Overview = null;
        SetStatus("", error: false);
    }

    private async Task RefreshGatewayAsync()
    {
        if (IsBusy || SelectedGateway is null) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            Overview = await GatewayOps.GetOverviewAsync(SelectedGateway.Id);
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private Task StartAsync(ApplicationGatewayInfo gateway) => RunActionAsync(gateway, GatewayOps.StartAsync, T("Starting {0}...", gateway.Name));
    private Task StopAsync(ApplicationGatewayInfo gateway) => RunActionAsync(gateway, GatewayOps.StopAsync, T("Stopping {0}...", gateway.Name));

    private async Task RunActionAsync(ApplicationGatewayInfo gateway, Func<string, CancellationToken, Task> action, string verb)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(verb, error: false);
        StateHasChanged();

        try
        {
            await action(gateway.Id, CancellationToken.None);

            if (SelectedGateway is not null)
            {
                Overview = await GatewayOps.GetOverviewAsync(SelectedGateway.Id);
            }
            else
            {
                await LoadAsync(string.IsNullOrEmpty(SelectedSubscriptionId)
                    ? Subscriptions.Select(s => s.SubscriptionId).ToList()
                    : new[] { SelectedSubscriptionId });
            }

            SetStatus(T("Operation completed."), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
