    private async Task LoadInvocationsAsync()
    {
        IsBusy = true;
        SetStatus(T("Reading logs..."), error: false);
        StateHasChanged();

        try
        {
            // Resolve the function app's own subscription, not the (possibly empty) page-level
            // filter, since App Insights component lookup needs a concrete subscription.
            var subscriptionId = GetSubscriptionId(SelectedFunctionAppId) ?? SelectedSubscriptionId;
            InvocationReport = await Functions.GetInvocationReportAsync(
                subscriptionId, SelectedFunctionAppId, new FunctionInvocationQuery(LogHours, LogMaxRows, LogOnlyFailures));
            LogRangeLabel = LogHours switch
            {
                1 => T("past hour"),
                < 48 => T("past {0} hours", LogHours),
                _ => T("past {0} days", LogHours / 24),
            };
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private List<KeyVaultReferenceInfo>? KvReferences { get; set; }
    private Dictionary<string, string> KvLatest { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private async Task LoadKeyVaultReferencesAsync()
    {
        IsBusy = true;
        SetStatus(T("Reading references..."), error: false);
        StateHasChanged();

        try
        {
            var references = await Functions.GetKeyVaultReferencesAsync(SelectedFunctionAppId);
            var latest = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            // Best effort, metadata only: when the version history of a secret cannot be read (no permission, vault behind a firewall) the cell stays "-".
            foreach (var group in references.GroupBy(r => (r.Vault, r.Secret)))
            {
                try
                {
                    var versions = await KeyVaultSecrets.ListSecretVersionsAsync($"https://{group.Key.Vault}.vault.azure.net/", group.Key.Secret);
                    if (versions.FirstOrDefault()?.CreatedOn is { } created)
                    {
                        latest[$"{group.Key.Vault}/{group.Key.Secret}"] = $"{created.LocalDateTime:g} ({(versions.Count == 1 ? T("{0} version", versions.Count) : T("{0} versions", versions.Count))})";
                    }
                }
                catch
                {
                }
            }

            KvLatest = latest;
            KvReferences = references;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    // Asks App Service to resolve every Key Vault reference again now (no restart), then shows the new status.
    private async Task RefreshKeyVaultReferencesAsync()
    {
        IsBusy = true;
        SetStatus(T("Requesting a re-read of the references..."), error: false);
        StateHasChanged();

        try
        {
            await Functions.RefreshKeyVaultReferencesAsync(SelectedFunctionAppId);
            await Task.Delay(TimeSpan.FromSeconds(5)); // the platform resolves them in the background
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
            IsBusy = false;
            return;
        }

        IsBusy = false;
        await LoadKeyVaultReferencesAsync();
        SetStatus(T("Re-read requested: if any reference is still failing, reload the status in a few seconds."), error: false);
    }

    private Task StartAsync() => RunLifecycleActionAsync(AppServiceOps.StartAsync, "Starting...");
    private Task StopAsync() => RunLifecycleActionAsync(AppServiceOps.StopAsync, "Stopping...");
    private Task RestartAsync() => RunLifecycleActionAsync(AppServiceOps.RestartAsync, "Restarting...");

    // statusText is the English text of the progress message; it is translated here.
    private async Task RunLifecycleActionAsync(Func<string, CancellationToken, Task> action, string statusText)
    {
        IsBusy = true;
        SetStatus(T(statusText), error: false);
        StateHasChanged();

        try
        {
            await action(SelectedFunctionAppId, CancellationToken.None);
            await LoadFunctionAppListAsync();
            Overview = await AppServiceOps.GetOverviewAsync(SelectedFunctionAppId);
            SetStatus(T("Operation completed."), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

