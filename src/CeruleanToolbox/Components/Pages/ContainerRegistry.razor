    private async Task DeleteTagAsync(string tag)
    {
        if (Credentials is null || SelectedRegistry is null || SelectedRepository is null) return;

        // Guards against a double-click firing this twice before the "disabled" attribute
        // re-renders in the browser: Blazor Server processes UI events one at a time per
        // circuit, so this in-memory check is enough to make the second click a no-op.
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Deleting tag \"{0}\"...", tag), error: false);
        StateHasChanged();

        try
        {
            await AcrOps.DeleteTagAsync(
                SelectedRegistry.LoginServer, Credentials.Username, Credentials.Passwords[0].Value, SelectedRepository, tag);
            Tags = await AcrOps.ListTagsAsync(
                SelectedRegistry.LoginServer, Credentials.Username, Credentials.Passwords[0].Value, SelectedRepository);
            SetStatus(T("Tag \"{0}\" deleted.", tag), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteRepositoryAsync(string repository)
    {
        if (Credentials is null || SelectedRegistry is null) return;

        // Guards against a double-click firing this twice before the "disabled" attribute
        // re-renders in the browser: Blazor Server processes UI events one at a time per
        // circuit, so this in-memory check is enough to make the second click a no-op.
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Deleting repository \"{0}\"...", repository), error: false);
        StateHasChanged();

        try
        {
            await AcrOps.DeleteRepositoryAsync(SelectedRegistry.LoginServer, Credentials.Username, Credentials.Passwords[0].Value, repository);
            Repositories = await AcrOps.ListRepositoriesAsync(SelectedRegistry.LoginServer, Credentials.Username, Credentials.Passwords[0].Value);
            if (SelectedRepository == repository)
            {
                SelectedRepository = null;
                Tags = null;
            }

            SetStatus(T("Repository \"{0}\" deleted.", repository), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
