@page "/containerregistry"
@using CeruleanToolbox.Services
@inject ResourceInventoryService Inventory
@inject ContainerRegistryService AcrOps
@inject IJSRuntime JS
@implements IAsyncDisposable
@inherits CeruleanToolboxPageBase

<PageTitle>Container Registry</PageTitle>

<h1>Container Registry</h1>

@if (SelectedRegistry is null)
{
    <p>
        @T("Lists Azure container registries. Click a registry name, or double-click its row, to open its overview, admin credentials and repositories.")
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <label class="form-label">@T("Subscription (optional)")</label>
            <SearchableSelect TItem="SubscriptionInfo" Items="Subscriptions"
                               GetLabel="@(s => $"{s.DisplayName} ({s.SubscriptionId})")" GetValue="@(s => s.SubscriptionId)"
                               SelectedValue="SelectedSubscriptionId" SelectedValueChanged="OnSubscriptionChangedAsync"
                               Placeholder='@T("-- all --")' Disabled="@(IsLoading || IsBusy)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">@T("Filter by name")</label>
            <input class="form-control" placeholder='@T("filter...")' @bind="NameFilter" @bind:event="oninput" />
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-info")">@StatusMessage</div>
}

@if (SelectedRegistry is null)
{
    @if (string.IsNullOrEmpty(SelectedSubscriptionId) && !HasLoadedAllSubscriptions && !IsLoading)
    {
        <div class="alert alert-secondary">
            @T("No subscription selected: pick one for a quick view, or")
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadAllSubscriptionsAsync">@T("Load all subscriptions")</button>
            @T("— this can take a while if you have many.")
        </div>
    }

    @if (IsLoading)
    {
        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
            <span>@T("Loading...")</span>
        </div>
    }

    @if (!IsLoading && (!string.IsNullOrEmpty(SelectedSubscriptionId) || HasLoadedAllSubscriptions))
    {
        @if (!FilteredRegistries.Any())
        {
            <p><em>@T("No container registries found.")</em></p>
        }
        else
        {
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr><th>@T("Name")</th><th>Subscription</th><th>Resource Group</th><th>Login Server</th><th>SKU</th><th>Admin User</th></tr>
                </thead>
                <tbody>
                    @foreach (var registry in FilteredRegistries)
                    {
                        <tr style="cursor: pointer;" title='@T("Double-click to open the registry")' @ondblclick="() => OpenRegistryAsync(registry)">
                            <td>
                                <button class="btn btn-link p-0 fw-semibold text-decoration-none" disabled="@IsBusy" @onclick="() => OpenRegistryAsync(registry)">
                                    @registry.Name <span aria-hidden="true">&rsaquo;</span>
                                </button>
                            </td>
                            <td>@GetSubscriptionName(registry.Id)</td>
                            <td>@registry.ResourceGroup</td>
                            <td>@registry.LoginServer</td>
                            <td>@registry.Sku</td>
                            <td>@(registry.AdminUserEnabled ? T("Enabled") : T("Disabled"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="CloseRegistry">&larr; Container Registry</button>
        <h4 class="mb-0">@SelectedRegistry.Name</h4>
        @if (Overview is not null)
        {
            <span class="badge bg-secondary">@Overview.Status</span>
        }
        <button class="btn btn-sm btn-outline-secondary ms-auto" disabled="@IsBusy" @onclick="RefreshRegistryAsync">@T("Refresh")</button>
    </div>
    <p class="text-muted small">
        @GetSubscriptionName(SelectedRegistry.Id) · Resource group @SelectedRegistry.ResourceGroup · @SelectedRegistry.Location
    </p>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(ActiveTab == "overview" ? "active" : "")" @onclick='() => ActiveTab = "overview"'>@T("Overview")</button></li>
        <li class="nav-item"><button class="nav-link @(ActiveTab == "repos" ? "active" : "")" @onclick='() => ActiveTab = "repos"'>@T("Credentials and repositories")</button></li>
        <li class="nav-item"><button class="nav-link @(ActiveTab == "firewall" ? "active" : "")" @onclick="OpenFirewallTabAsync">@T("Firewall")</button></li>
    </ul>

    @if (ActiveTab == "overview" && Overview is not null)
    {
        <ResourceOverviewView Overview="Overview" />
    }
    else if (ActiveTab == "firewall")
    {
        <p class="text-muted small">
            @T("IP rules decide which addresses may read and change the images of this registry. The change takes a few minutes to apply. The list is read from Azure every time and written back as a whole, so rules added by others are kept.")
        </p>
        @if (Rules is null)
        {
            <p><em>@T("Loading...")</em></p>
        }
        else
        {
            @if (!string.Equals(Rules.Sku, "Premium", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-warning">@T("This registry is {0}: Azure documents IP rules only for the Premium tier, so a change may be refused.", Rules.Sku)</div>
            }
            <p>
                @T("Public network access"): <strong>@Rules.PublicNetworkAccess</strong> ·
                @T("Default network rule"): <strong>@Rules.DefaultAction</strong>
            </p>
            @if (Rules.DefaultAction == "Allow")
            {
                <div class="alert alert-secondary">@T("The default rule is Allow: every address is already accepted, so IP rules have no effect until the default rule is Deny.")</div>
            }

            @if (Rules.IpRules.Count == 0)
            {
                <p><em>@T("No IP rules.")</em></p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>@T("Value")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var rule in Rules.IpRules)
                        {
                            <tr @key="rule">
                                <td><code>@rule</code></td>
                                <td>
                                    <ConfirmDeleteButton ConfirmText="@rule" ButtonLabel='@T("Remove rule")' ConfirmLabel='@T("Confirm removal")' IsBusy="IsBusy"
                                                          OnConfirmed="() => ChangeRuleAsync(rule, add: false)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h4 class="mt-3">@T("Add an IP rule")</h4>
            @if (!string.IsNullOrEmpty(BlockedIpFound) && !Rules.IpRules.Contains(BlockedIpFound))
            {
                <p class="small">
                    @T("The registry refused the address {0}.", BlockedIpFound)
                    <button class="btn btn-sm btn-outline-primary ms-1" disabled="@IsBusy" @onclick="() => NewRule = BlockedIpFound">@T("Use it")</button>
                </p>
            }
            <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                <input class="form-control form-control-sm" style="width: 14rem;" placeholder="1.2.3.4 / 1.2.3.0/24"
                       @bind="NewRule" @bind:event="oninput" disabled="@(IsBusy || PendingRule is not null)" />
                <button class="btn btn-sm btn-outline-primary" disabled="@(IsBusy || PendingRule is not null)" @onclick="AskAddRule">@T("Add")</button>
            </div>
            @if (PendingRule is not null)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 flex-wrap">
                    <span>@T("Allow {0} to access the registry {1}?", PendingRule, SelectedRegistry.Name)</span>
                    <button class="btn btn-sm btn-primary" disabled="@IsBusy" @onclick="ConfirmAddRuleAsync">@T("Confirm")</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="() => PendingRule = null">@T("Cancel")</button>
                </div>
            }
        }
    }
    else if (ActiveTab == "repos")
    {
        <p class="text-muted small">
            @T("Reading repositories and tags uses the registry's own Docker Registry v2 API (not covered by the ARM SDK, which only manages the resource) and authenticates with the admin credentials: the Admin User must therefore be enabled on the registry.")
        </p>
        <h3 class="mt-3">@T("Admin credentials")</h3>
        @if (!SelectedRegistry.AdminUserEnabled)
        {
            <div class="alert alert-warning">
                @T("Admin User is disabled on this registry: without admin credentials this page cannot read repositories/tags (an AAD token exchange against RBAC permissions on the registry would be needed instead, not implemented here).")
                <button class="btn btn-sm btn-outline-primary ms-2" disabled="@IsBusy" @onclick="EnableAdminUserAsync">@T("Enable Admin User")</button>
            </div>
        }
        else
        {
            <div class="mb-3">
                <button class="btn btn-sm btn-outline-secondary" disabled="@IsBusy" @onclick="ToggleCredentialsAsync">
                    @(Credentials is not null ? T("Hide credentials") : T("Show credentials"))
                </button>
            </div>
            @if (Credentials is not null)
            {
                <table class="table table-sm">
                    <thead><tr><th>@T("Field")</th><th>@T("Value")</th><th></th></tr></thead>
                    <tbody>
                        <tr><td>Username</td><td><code>@Credentials.Username</code></td><td></td></tr>
                        @foreach (var pwd in Credentials.Passwords)
                        {
                            <tr>
                                <td>@pwd.Name</td>
                                <td><code>@pwd.Value</code></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@IsBusy" @onclick="() => RegenerateCredentialAsync(pwd.Name)">@T("Regenerate")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h3 class="mt-3">Repository</h3>
                @if (Repositories is null)
                {
                    <button class="btn btn-sm btn-outline-primary" disabled="@IsBusy" @onclick="LoadRepositoriesAsync">@T("Load repositories")</button>
                }
                else if (Repositories.Count == 0)
                {
                    <p><em>@T("No repositories found.")</em></p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>@T("Name")</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var repo in Repositories)
                            {
                                <tr class="@(SelectedRepository == repo ? "table-success" : "")" @key="repo">
                                    <td>@repo</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" disabled="@IsBusy" @onclick="() => LoadTagsAsync(repo)">@T("Show tags")</button>
                                        <ConfirmDeleteButton ConfirmText="@repo" ButtonLabel='@T("Delete repository")' IsBusy="IsBusy"
                                                              OnConfirmed="() => DeleteRepositoryAsync(repo)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (SelectedRepository is not null && Tags is not null)
                {
                    <h4>@T("Tags of") <code>@SelectedRepository</code></h4>
                    @if (Tags.Count == 0)
                    {
                        <p><em>@T("No tags found.")</em></p>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead><tr><th>Tag</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var tag in Tags)
                                {
                                    <tr @key="tag">
                                        <td><code>@SelectedRegistry.LoginServer/@SelectedRepository:@tag</code></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" disabled="@IsBusy" @onclick="() => LoadImageDetailAsync(tag)">@T("Details")</button>
                                            <ConfirmDeleteButton ConfirmText="@tag" ButtonLabel='@T("Delete tag")' IsBusy="IsBusy"
                                                                  OnConfirmed="() => DeleteTagAsync(tag)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (Detail is not null && DetailTag is not null)
                        {
                            <h4 id="image-detail">@T("Image details of")  <code>@SelectedRepository:@DetailTag</code></h4>
                            @if (Detail.Note is not null)
                            {
                                <p class="text-muted small">@Detail.Note</p>
                            }
                            <table class="table table-sm w-auto">
                                <tbody>
                                    <tr><td>Digest</td><td><code>@Detail.Digest</code></td></tr>
                                    <tr><td>@T("System / architecture")</td><td>@Detail.Os / @Detail.Architecture</td></tr>
                                    @if (Detail.Platforms.Count > 0)
                                    {
                                        <tr><td>@T("Platforms in the tag")</td><td>@string.Join(", ", Detail.Platforms)</td></tr>
                                    }
                                    <tr><td>@T("Created")</td><td>@Detail.Created</td></tr>
                                    <tr><td>@T("Size")</td><td>@($"{Detail.SizeBytes / 1024.0 / 1024.0:0.#} MB") · @T("{0} layers", Detail.Layers)</td></tr>
                                    <tr><td>@T("User")</td><td>@Detail.User</td></tr>
                                    <tr><td>@T("Working directory")</td><td>@Detail.WorkingDir</td></tr>
                                    <tr><td>Entrypoint</td><td><code>@(Detail.Entrypoint.Length == 0 ? "-" : Detail.Entrypoint)</code></td></tr>
                                    <tr><td>Cmd</td><td><code>@(Detail.Cmd.Length == 0 ? "-" : Detail.Cmd)</code></td></tr>
                                    <tr><td>@T("Exposed ports")</td><td>@(Detail.Ports.Length == 0 ? "-" : Detail.Ports)</td></tr>
                                    <tr>
                                        <td>@T("Runtime (guess)")</td>
                                        <td>
                                            @if (Detail.Runtime.Count == 0)
                                            {
                                                <em>@T("Not recognized: the image has no known version variable or start command.")</em>
                                            }
                                            else
                                            {
                                                @foreach (var hint in Detail.Runtime)
                                                {
                                                    <div><strong>@hint.Runtime</strong> <span class="text-muted small">(@hint.Basis)</span></div>
                                                }
                                                <div class="text-muted small">@T("A guess from the base image variables and the start command, not a recorded fact.")</div>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <details class="mb-2">
                                <summary>@T("Labels ({0})", Detail.Labels.Count)</summary>
                                @if (Detail.Labels.Count == 0)
                                {
                                    <p><em>@T("The image has no labels.")</em></p>
                                }
                                else
                                {
                                    <table class="table table-sm">
                                        <tbody>
                                            @foreach (var label in Detail.Labels)
                                            {
                                                <tr><td>@label.Key</td><td><code>@label.Value</code></td></tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </details>
                            <details class="mb-2">
                                <summary>@T("Environment variables ({0})", Detail.Env.Count)</summary>
                                <p class="text-muted small">@T("Values of variables whose name suggests a secret are hidden.")</p>
                                <table class="table table-sm">
                                    <tbody>
                                        @foreach (var variable in Detail.Env)
                                        {
                                            <tr>
                                                <td>@variable.Key</td>
                                                <td><code>@(ContainerRegistryService.IsSensitiveName(variable.Key) ? T("(hidden)") : variable.Value)</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </details>
                            <details class="mb-3">
                                <summary>@T("Build history ({0})", Detail.History.Count)</summary>
                                <p class="text-muted small">@T("The commands that created each layer, as recorded in the image. They can contain build arguments.")</p>
                                <ol class="small">
                                    @foreach (var step in Detail.History)
                                    {
                                        <li><code>@step</code></li>
                                    }
                                </ol>
                            </details>
                        }
                    }
                }
            }
        }

    }
}

@code {
    private List<AcrRegistryInfo> Registries { get; set; } = new();
    private AcrCredentialsInfo? Credentials { get; set; }
    private List<string>? Repositories { get; set; }
    private List<string>? Tags { get; set; }

    private string SelectedSubscriptionId { get; set; } = "";
    private string SelectedRegistryId { get; set; } = "";
    private string? SelectedRepository { get; set; }
    private string NameFilter { get; set; } = "";
    private ResourceOverview? Overview { get; set; }
    private string ActiveTab { get; set; } = "overview";
    private AcrNetworkRules? Rules { get; set; }
    private string NewRule { get; set; } = "";
    private string? PendingRule { get; set; }
    private string? BlockedIpFound { get; set; }
    private AcrImageDetail? Detail { get; set; }
    private string? DetailTag { get; set; }
    private bool _scrollToDetail;
    private IJSObjectReference? _scrollModule;

    // The panel exists in the page only after the render that follows the load, so the scroll waits for that render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToDetail || Detail is null) return;
        _scrollToDetail = false;

        try
        {
            _scrollModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/scroll.js");
            await _scrollModule.InvokeVoidAsync("scrollToId", "image-detail");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Scrolling is a convenience: if the browser connection is gone or the module is missing, the panel is still there.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollModule is null) return;
        try
        {
            await _scrollModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadImageDetailAsync(string tag)
    {
        if (Credentials is null || SelectedRegistry is null || SelectedRepository is null || IsBusy) return;

        IsBusy = true;
        SetStatus(T("Reading the image \"{0}\"...", tag), error: false);
        StateHasChanged();

        try
        {
            Detail = await AcrOps.GetImageDetailAsync(
                SelectedRegistry.LoginServer, Credentials.Username, Credentials.Passwords[0].Value, SelectedRepository, tag);
            DetailTag = tag;
            _scrollToDetail = true;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            RememberBlockedIp(ex);
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task OpenFirewallTabAsync()
    {
        ActiveTab = "firewall";
        if (Rules is null) await LoadRulesAsync();
    }

    private async Task LoadRulesAsync()
    {
        if (SelectedRegistry is null) return;
        try
        {
            Rules = await AcrOps.GetNetworkRulesAsync(SelectedRegistry.Id);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
    }

    private void AskAddRule()
    {
        var rule = ContainerRegistryService.NormalizeIpRule(NewRule, out var problem);
        if (rule is null)
        {
            SetStatus(problem, error: true);
            return;
        }

        SetStatus("", error: false);
        PendingRule = rule;
    }

    private async Task ConfirmAddRuleAsync()
    {
        if (PendingRule is null) return;
        var rule = PendingRule;
        PendingRule = null;
        await ChangeRuleAsync(rule, add: true);
        if (!IsError) NewRule = "";
    }

    private async Task ChangeRuleAsync(string rule, bool add)
    {
        if (IsBusy || SelectedRegistry is null) return;

        IsBusy = true;
        SetStatus(add ? T("Adding rule {0}...", rule) : T("Removing rule {0}...", rule), error: false);
        StateHasChanged();

        try
        {
            Rules = await AcrOps.ChangeIpRuleAsync(SelectedRegistry.Id, rule, add);
            SetStatus(add ? T("Rule {0} added. It may take a few minutes to apply.", rule) : T("Rule {0} removed.", rule), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    // The registry's refusal names the address it saw: keep it so the Firewall tab can offer it.
    private void RememberBlockedIp(Exception ex)
    {
        var ip = ContainerRegistryService.BlockedIp(ex.Message);
        if (ip is not null) BlockedIpFound = ip;
    }

    private IEnumerable<AcrRegistryInfo> FilteredRegistries => Registries.Where(r =>
        string.IsNullOrWhiteSpace(NameFilter) || r.Name.Contains(NameFilter, StringComparison.OrdinalIgnoreCase));

    private AcrRegistryInfo? SelectedRegistry =>
        Registries.FirstOrDefault(r => r.Id == SelectedRegistryId);


    protected override async Task OnInitializedAsync()
    {
        try
        {
            Subscriptions = await Inventory.ListSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }

        await AutoOpenAsync();
    }

    private async Task AutoOpenAsync()
    {
        var id = RequestedResourceId;
        if (id is null || Subscriptions.Count == 0) return;

        await OnSubscriptionChangedAsync(RequestedSubscriptionId ?? "");
        var item = Registries.FirstOrDefault(x => string.Equals(x.Id, id, StringComparison.OrdinalIgnoreCase));
        if (item is not null)
        {
            await OpenRegistryAsync(item);
        }
    }

    private async Task OnSubscriptionChangedAsync(string subscriptionId)
    {
        SelectedSubscriptionId = subscriptionId;
        Registries.Clear();
        ClearSelectedRegistry();
        HasLoadedAllSubscriptions = false;

        // Clearing back to "all" doesn't auto-load: fetching every subscription is expensive,
        // so it waits for the explicit button below instead of firing on every selection change.
        if (string.IsNullOrEmpty(SelectedSubscriptionId)) return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            Registries = await AcrOps.ListAllAsync(SelectedSubscriptionId);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadAllSubscriptionsAsync()
    {
        HasLoadedAllSubscriptions = true;
        IsLoading = true;
        StateHasChanged();

        try
        {
            var registries = new List<AcrRegistryInfo>();
            foreach (var sub in Subscriptions)
            {
                registries.AddRange(await AcrOps.ListAllAsync(sub.SubscriptionId));
            }

            Registries = registries;
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ClearSelectedRegistry()
    {
        SelectedRegistryId = "";
        Overview = null;
        Credentials = null;
        Repositories = null;
        Tags = null;
        SelectedRepository = null;
        Rules = null;
        Detail = null;
        DetailTag = null;
        NewRule = "";
        PendingRule = null;
        BlockedIpFound = null;
    }

    private async Task OpenRegistryAsync(AcrRegistryInfo registry)
    {
        if (IsBusy) return;

        IsBusy = true;
        SetStatus(T("Opening {0}...", registry.Name), error: false);
        StateHasChanged();

        try
        {
            Overview = await AcrOps.GetOverviewAsync(registry.Id);
            SelectedRegistryId = registry.Id;
            ActiveTab = "overview";
            Rules = null;
            Credentials = null;
            Repositories = null;
            Tags = null;
            SelectedRepository = null;
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void CloseRegistry()
    {
        ClearSelectedRegistry();
        SetStatus("", error: false);
    }

    private async Task RefreshRegistryAsync()
    {
        if (IsBusy || SelectedRegistry is null) return;

        IsBusy = true;
        StateHasChanged();

        try
        {
            Overview = await AcrOps.GetOverviewAsync(SelectedRegistry.Id);
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task EnableAdminUserAsync()
    {
        IsBusy = true;
        SetStatus(T("Enabling Admin User..."), error: false);
        StateHasChanged();

        try
        {
            await AcrOps.SetAdminUserEnabledAsync(SelectedRegistryId, enabled: true);
            var index = Registries.FindIndex(r => r.Id == SelectedRegistryId);
            Registries[index] = Registries[index] with { AdminUserEnabled = true };
            SetStatus(T("Admin User enabled."), error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task ToggleCredentialsAsync()
    {
        if (Credentials is not null)
        {
            Credentials = null;
            Repositories = null;
            Tags = null;
            SelectedRepository = null;
            return;
        }

        IsBusy = true;
        SetStatus(T("Retrieving credentials..."), error: false);
        StateHasChanged();

        try
        {
            Credentials = await AcrOps.GetCredentialsAsync(SelectedRegistryId);
            SetStatus("", error: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, error: true);
        }
        finally
        {
            IsBusy = false;
        }
    }

